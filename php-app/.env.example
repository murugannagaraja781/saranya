# ============================================================================
# Naga AI Assistant (Saranya) — Hostinger Production Environment Configuration
# Copy this file to .env and configure your production credentials.
# NEVER commit the actual .env file to GitHub!
# ============================================================================

# Environment Mode: 'production' or 'development'
# In production, PHP errors are hidden from the screen and logged to logs/error.log
APP_ENV=production
APP_URL=https://ai.tenkasidreams.com

# Database Connection (Hostinger MySQL)
# Note: On Hostinger, DB_HOST is usually 'localhost' or '127.0.0.1'
# DB_NAME and DB_USER typically follow the format: u123456789_dbname
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_saranya_db
DB_USER=u123456789_saranya_user
DB_PASSWORD=your_secure_database_password_here

# Assistant Persona & Owner Details
OWNER_NAME=Naga
OWNER_PHONE=+916382379565
OWNER_EMAIL=naga@yourdomain.com

AI_ASSISTANT_NAME=Arya
AI_LANGUAGE=Tamil
AI_VOICE_STYLE=Natural Chennai conversational Tamil

# Quiet Hours Configuration (24-hour format)
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00
ALLOW_HIGH_PRIORITY_IN_QUIET_HOURS=true

# Mock Mode (Set to false for live production AI & telephony)
# When MOCK_MODE=false, GEMINI_API_KEY is required
MOCK_MODE=false

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Telephony Provider (Vobiz)
VOBIZ_BASE_URL=https://api.vobiz.ai/v1
VOBIZ_AUTH_ID=your_vobiz_auth_id
VOBIZ_AUTH_TOKEN=your_vobiz_auth_token
VOBIZ_NUMBER=+914400000000

# Voice Agent Provider (SnapServe AI)
SNAPSERVE_BASE_URL=https://api.snapserve.ai/v1
SNAPSERVE_API_KEY=your_snapserve_api_key
SNAPSERVE_AGENT_ID=your_snapserve_agent_id

# Webhook Secrets (Used to verify incoming requests)
N8N_WEBHOOK_SECRET=your_secure_n8n_secret_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_secure_whatsapp_verify_token

# Outbound Auto-Reply Dispatch (to reply back to Client via WhatsApp or n8n)
N8N_OUTBOUND_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/send-whatsapp-reply
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
