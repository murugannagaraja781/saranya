# ============================================================================
# Naga AI Assistant (Saranya) — Hostinger Production Apache Configuration
# Optimized for Hostinger Shared Hosting & Subdomains (Apache & LiteSpeed)
# ============================================================================

# 1. Prevent Directory Indexing / File Browsing
Options -Indexes -MultiViews

# 2. Set Default Character Encoding
AddDefaultCharset UTF-8

# 3. Security: Block Access to Sensitive Files and Directories
<FilesMatch "^(\.env|\.env\.example|\.git|\.gitignore|composer\.(json|lock)|package(-lock)?\.json|.*\.sql|.*\.log|.*\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block direct access to sensitive backend folders
RedirectMatch 403 ^/database/.*$
RedirectMatch 403 ^/logs/.*$
RedirectMatch 403 ^/backend/config/.*$

# 4. HTTP Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. URL Rewriting & Routing
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # If request is for an existing file or directory in public/ or backend/, serve it
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route Root to public/index.html
    RewriteRule ^$ public/index.html [L]

    # Route Super Admin Dashboard
    RewriteRule ^admin/?$ public/admin.html [L]
    RewriteRule ^admin\.html$ public/admin.html [L]

    # Route static assets (css, js) to public/ folder
    RewriteRule ^css/(.*)$ public/css/$1 [L]
    RewriteRule ^js/(.*)$ public/js/$1 [L]

    # Route clean API and Webhook calls
    RewriteRule ^api/(.*)$ backend/api/$1 [L,QSA]
    RewriteRule ^webhooks/(.*)$ backend/webhooks/$1 [L,QSA]

    # Fallback to public/index.html for any frontend dashboard route
    RewriteCond %{REQUEST_URI} !^/backend/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/index.html [L]
</IfModule>

# 6. Gzip / Deflate Compression for Speed
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
